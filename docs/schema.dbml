Enum card_brand {
  MASTERCARD
  VISA
}

Table users {
  id            integer      [pk, increment]
  email         varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  name          varchar(100) [not null]
  last_name     varchar(100) [not null]
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]
}

Table cards {
  id          integer       [pk, increment]
  user_id     integer       [not null, ref: > users.id]
  holder_name varchar(100)  [not null]
  brand       card_brand    [not null]
  last4       char(4)       [not null]
  exp_month   smallint      [not null, note: 'CHECK 1-12']
  exp_year    smallint      [not null]
  currency    char(3)       [not null, note: 'ISO 4217, ej: USD']
  balance     numeric(12,2) [not null, default: 0]
  created_at  timestamptz   [not null, default: `now()`]
  updated_at  timestamptz   [not null, default: `now()`]

  indexes {
    user_id
  }
}

Table movement_types {
  id          integer      [pk, increment]
  code        varchar(30)  [not null, unique, note: 'SUBSCRIPTION | CASH_IN | CASH_OUT']
  label       varchar(100) [not null, note: 'Pago de suscripción | Pago recibido | Pago enviado']
  is_negative boolean      [not null]
}

Table movements {
  id           integer       [pk, increment]
  card_id      integer       [not null, ref: > cards.id]
  type_id      integer       [not null, ref: > movement_types.id]
  counterparty varchar(100)  [not null, note: 'Adobe, José Suárez...']
  description  varchar(255)  [note: 'Opcional: notas extra del movimiento']
  amount       numeric(12,2) [not null, note: 'CHECK amount > 0']
  occurred_at  timestamptz   [not null]
  created_at   timestamptz   [not null, default: `now()`]
  updated_at   timestamptz   [not null, default: `now()`]

  indexes {
    (card_id, occurred_at)
  }
}
